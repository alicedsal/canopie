# Copy to .env (never commit .env)

# --- Tiger Data (Postgres + TimescaleDB) ---
# Local docker-compose default. For the demo, swap in the Tiger Cloud service URL.
DATABASE_URL=postgresql://canopy:canopy@localhost:5432/canopy

# --- Gemini ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# --- Frontend origin allowed by CORS ---
FRONTEND_ORIGIN=http://localhost:5173

# --- Salt for hashing constituent phone numbers before storage ---
SENDER_HASH_SALT=change-me

# --- Snowflake Cortex (optional stretch, see docs/PLAN.md phase 8) ---
SNOWFLAKE_ACCOUNT_URL=
SNOWFLAKE_PAT=
SNOWFLAKE_MODEL=claude-sonnet-4-5
