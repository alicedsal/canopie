# Copy to .env.local
VITE_GOOGLE_MAPS_API_KEY=
# AdvancedMarker needs a Map ID. DEMO_MAP_ID works for development.
VITE_GOOGLE_MAP_ID=DEMO_MAP_ID
VITE_API_URL=http://localhost:8000
# The agent's iMessage number from the Photon dashboard, e.g. +19195550123. Shows a QR code when set.
VITE_AGENT_NUMBER=
